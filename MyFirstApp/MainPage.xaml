<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
           
                <Label x:Name="Screen" HorizontalOptions="Fill"></Label>
 
            <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*,*" Padding="10" ColumnSpacing="5" RowSpacing="5">
     
                <Button x:Name="Digit1" Text="1" CommandParameter="1" Grid.Row="0" Grid.Column="0"  Clicked="DigitClicked"></Button>
                <Button x:Name="Digit2" Text="2" CommandParameter="2" Grid.Row="0" Grid.Column="1" Clicked="DigitClicked"></Button>
                <Button x:Name="Digit3" Text="3" CommandParameter="3" Grid.Row="0" Grid.Column="2" Clicked="DigitClicked"></Button>
                <Button x:Name="SumOperator" Text="+"  Grid.Row="0" Grid.Column="3" Clicked="SumOperator_OnClicked"></Button>
     
                <Button x:Name="Digit4" Text="4" CommandParameter="4" Grid.Row="1" Grid.Column="0"  Clicked="DigitClicked"></Button>
                <Button x:Name="Digit5" Text="5" CommandParameter="5" Grid.Row="1" Grid.Column="1" Clicked="DigitClicked"></Button>
                <Button x:Name="Digit6" Text="6" CommandParameter="6" Grid.Row="1" Grid.Column="2" Clicked="DigitClicked"></Button>
                <Button x:Name="MinusOperator" Text="-"  Grid.Row="1" Grid.Column="3" Clicked="MinusOperator_OnClicked"></Button>
                
                <Button x:Name="Digit7" Text="7" CommandParameter="7" Grid.Row="2" Grid.Column="0"  Clicked="DigitClicked"></Button>
                <Button x:Name="Digit8" Text="8" CommandParameter="8" Grid.Row="2" Grid.Column="1" Clicked="DigitClicked"></Button>
                <Button x:Name="Digit9" Text="9" CommandParameter="9" Grid.Row="2" Grid.Column="2" Clicked="DigitClicked"></Button>
                <Button x:Name="MultiplyOperator" Text="*"  Grid.Row="2" Grid.Column="3" Clicked="MultiplyOperator_OnClicked"></Button>
                
                <Button x:Name="Digit0" Text="0" CommandParameter="9" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Clicked="DigitClicked"></Button>
                <Button x:Name="EqualOperator" Text="="  Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Clicked="EqualOperator_OnClicked"></Button>
                
            </Grid>
            
       
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
